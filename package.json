{
  "name": "@dependahub/aws-dynamo",
  "version": "0.1.0",
  "description": "AWS Dynamo DB / DocumentClient Wrapper",
  "license": "MIT",
  "repository": "github:dependahub/aws-dynamo",
  "bugs": "https://github.com/dependahub/aws-dynamo/issues",
  "author": "madakaheri",
  "type": "module",
  "exports": {
    ".": {
      "types": "./@types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "sideEffects": true,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf @types && tsc",
    "lint": "xo",
    "format": "xo --fix",
    "test": "node --test",
    "prepublishOnly": "npm run format && npm run build"
  },
  "files": [
    "@types/",
    "src/"
  ],
  "keywords": [
    "aws",
    "dynamodb",
    "documentclient"
  ],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  }
}